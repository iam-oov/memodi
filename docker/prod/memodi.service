[Unit]
Description=Memodi MCP Server
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=memodi
WorkingDirectory=/home/memodi/memodi
EnvironmentFile=/home/memodi/memodi/docker/prod/.env
Environment=MEMODI_DB_HOST=localhost
# main() calls ensure_schema() at startup (DB connectivity + migrations)
# before serving. A broken DB or a failing migration exits nonzero here,
# so this unit crash-loops until it's fixed — the deploy health check
# (GET /signup) is what actually surfaces that failure.
ExecStart=/home/memodi/.local/bin/uv run memodi --http
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
