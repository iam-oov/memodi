# Copy to docker/prod/.env on the Pi — memodi.service reads it via
# EnvironmentFile. Never commit the real .env.

# Bind address. Cloudflared connects to the server locally, so the LAN must
# not reach :8787 directly — bind to loopback only in production.
MEMODI_HOST=127.0.0.1

# PostgreSQL connection. Any self-hosted PostgreSQL works (native install,
# per docs/pi-setup.md). Managed Postgres (RDS, Cloud SQL, etc.) does NOT —
# Apache AGE is not available as an extension on managed services.
MEMODI_DB_HOST=localhost
MEMODI_DB_PORT=5432
MEMODI_DB_USER=memodi
MEMODI_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MEMODI_DB_NAME=memodi

# Invite code required by the public /signup page. Must be non-empty:
# the deploy health check depends on GET /signup returning 200, and the
# server responds 503 there when signup is disabled (empty code).
MEMODI_SIGNUP_CODE=CHANGE_ME_INVITE_CODE
